    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "description": "Self-hosted, offline-first fitness and home-workout tracker. No account, no server; your data stays in your browser.",
  "license": "MIT"
}
